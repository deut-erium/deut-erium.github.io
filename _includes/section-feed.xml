{%- assign _posts = site.posts | where: 'section', page.section -%}<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ page.feed_title | xml_escape }}</title>
  <link href="{{ page.permalink | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ page.section_home | absolute_url }}" rel="alternate" type="text/html" />
  <id>{{ page.permalink | absolute_url }}</id>
  {%- if _posts.first %}<updated>{{ _posts.first.date | date_to_xmlschema }}</updated>{% endif %}
  <author><name>{{ site.author.name | xml_escape }}</name></author>
  {%- for _post in _posts limit: 20 %}
  <entry>
    <title>{{ _post.title | xml_escape }}</title>
    <link href="{{ _post.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ _post.url | absolute_url }}</id>
    <published>{{ _post.date | date_to_xmlschema }}</published>
    <updated>{{ _post.date | date_to_xmlschema }}</updated>
    {%- assign _summary = _post.description | default: _post.excerpt | strip_html | normalize_whitespace | truncate: 320 -%}
    <summary type="text">{{ _summary | xml_escape }}</summary>
  </entry>
  {%- endfor %}
</feed>
