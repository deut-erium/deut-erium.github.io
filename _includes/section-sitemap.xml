{%- assign _posts = site.posts | where: 'section', page.section -%}<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ page.section_home | absolute_url }}</loc></url>
  {%- for _post in _posts %}
  <url><loc>{{ _post.url | absolute_url }}</loc><lastmod>{{ _post.date | date_to_xmlschema }}</lastmod></url>
  {%- endfor %}
</urlset>
